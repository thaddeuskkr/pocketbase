# Local builds use this pinned version. The publishing workflow resolves upstream independently.
PB_VERSION=0.40.6

# After publishing, uncomment and replace with your lowercase GitHub owner/repository.
# POCKETBASE_IMAGE=ghcr.io/owner/repository:latest

# Use 127.0.0.1 to disable connections from other machines.
POCKETBASE_BIND_ADDRESS=0.0.0.0
POCKETBASE_PORT=8090
